{
  "manifest_version": 3,
  "name": "Quiet Tab",
  "version": "0.1.1",
  "description": "极简新标签页：一个永不跳变的时钟，配每日高清壁纸、搜索与天气。",
  "minimum_chrome_version": "120",

  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },

  "permissions": ["storage"],

  "host_permissions": [
    "https://www.bing.com/*",
    "https://api.unsplash.com/*",
    "https://images.unsplash.com/*",
    "https://suggestqueries.google.com/*",
    "https://api.bing.com/*",
    "https://duckduckgo.com/*"
  ],

  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
