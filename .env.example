# Copy to .env.local and fill in. .env.local is gitignored.
#
# There are TWO build flavours. Pick exactly one; the build refuses to run if
# both variables are set, because that would ship the key while looking safe.
#
# ── Flavour A: PERSONAL (your own machine only) ──────────────────────────────
# Register an application at https://unsplash.com/developers and use its
# ACCESS key. The Secret Key is for OAuth flows and must NOT be put here.
#
# WARNING: Vite inlines VITE_* variables into the built bundle. The key will be
# readable by anyone who inspects the packed extension. NEVER distribute a
# build made this way.
VITE_UNSPLASH_ACCESS_KEY=

# ── Flavour B: PUBLISH (safe to distribute) ──────────────────────────────────
# Deploy the Cloudflare Worker in ./worker, which holds the key as a secret, and
# put its https URL here. Leave VITE_UNSPLASH_ACCESS_KEY EMPTY for this flavour.
#   VITE_UNSPLASH_PROXY_URL=https://quiet-tab.ccwu.cc
VITE_UNSPLASH_PROXY_URL=

# With neither set, the extension silently uses Bing's daily image instead.
